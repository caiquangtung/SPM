FROM mcr.microsoft.com/dotnet/sdk:8.0 AS development
WORKDIR /app

# Install dotnet-ef tools for migrations (optional, can be installed later if needed)
# RUN dotnet tool install --global dotnet-ef --version 8.0.0
# ENV PATH="${PATH}:/root/.dotnet/tools"

# Copy csproj and restore dependencies
COPY ["project-service.csproj", "./"]
RUN dotnet restore "project-service.csproj"

# Copy everything else (source code will be mounted as volume in docker-compose)
COPY . .

# Expose port
EXPOSE 8080

# Use dotnet watch for hot reload
ENTRYPOINT ["dotnet", "watch", "run", "--no-launch-profile", "--urls", "http://0.0.0.0:8080"]

